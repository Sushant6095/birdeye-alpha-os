# Birdeye Data Services API key (https://docs.birdeye.so)
BIRDEYE_API_KEY=

# Neon Postgres connection string (https://console.neon.tech)
DATABASE_URL=

# Upstash Redis REST credentials (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generic Redis URL (kept for compatibility / future direct-TCP usage)
REDIS_URL=

# Anthropic API key (later: Claude integration)
ANTHROPIC_API_KEY=

# Optional: override Birdeye base URL for testing
# BIRDEYE_BASE_URL=https://public-api.birdeye.so

# Debug logging (1/0)
BIRDEYE_DEBUG=0
CACHE_DEBUG=0

# Sidecar URL the browser hits for SSE (Part 3). Public so it ships in JS.
NEXT_PUBLIC_WS_SIDECAR_URL=http://localhost:4001

# Optional override of upstream Birdeye WS host (sidecar only)
# BIRDEYE_WS_URL=wss://public-api.birdeye.so/socket

# Sidecar log level: error | warn | info | debug
LOG_LEVEL=info
