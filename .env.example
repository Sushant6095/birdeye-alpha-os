# Birdeye Data Services API key (https://docs.birdeye.so)
BIRDEYE_API_KEY=

# Neon Postgres connection string (https://console.neon.tech)
DATABASE_URL=

# Upstash Redis REST credentials (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generic Redis URL (kept for compatibility / future direct-TCP usage)
REDIS_URL=

# Anthropic API key (later: Claude integration)
ANTHROPIC_API_KEY=

# Optional: override Birdeye base URL for testing
# BIRDEYE_BASE_URL=https://public-api.birdeye.so

# Debug logging (1/0)
BIRDEYE_DEBUG=0
CACHE_DEBUG=0
